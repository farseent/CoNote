{
  "name": "@conote/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tiptap extensions and Yjs binding. Empty entry point until Phase 4.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@conote/shared": "workspace:*"
  }
}
