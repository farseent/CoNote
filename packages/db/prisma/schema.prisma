// CoNote Prisma schema.
// Phase 2: User and Session. Later phases add their models together with the
// code that uses them; the full design is in docs/DATABASE_SCHEMA.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identity ─────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(254)
  passwordHash      String
  displayName       String    @db.VarChar(80)
  presenceColor     String    @db.Char(7)
  passwordChangedAt DateTime  @default(now()) @db.Timestamptz(6)
  lastLoginAt       DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  sessions Session[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  userAgent         String?   @db.VarChar(512)
  ipAddress         String?   @db.VarChar(45)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime  @db.Timestamptz(6) // idle expiry (sliding)
  absoluteExpiresAt DateTime  @db.Timestamptz(6) // fixed maximum lifetime
  revokedAt         DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}
