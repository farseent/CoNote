// CoNote Prisma schema.
// Phase 1: no models. The first real models (User, Session) arrive in Phase 2
// per docs/IMPLEMENTATION_PLAN.md; the full design is in docs/DATABASE_SCHEMA.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
