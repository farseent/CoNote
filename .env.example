# CoNote local development environment.
# Copy to `.env` (never commit `.env`). Values below are LOCAL DEVELOPMENT DEFAULTS
# matching infra/docker-compose.yml; they are not secrets and must not be used in production.
# Only variables used by the current phase are listed. Later phases add theirs
# (sessions, cookies, object storage, ...) together with the code that uses them.

# --- Shared by all services ---
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (api, collab, prisma) ---
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below.
DATABASE_URL=postgresql://conote:conote_dev_password@localhost:5432/conote

# --- Redis (api, collab) ---
REDIS_URL=redis://localhost:6379

# --- API (apps/api) ---
PORT=4000
# Browser-facing origin of the web app (no path, no trailing slash).
APP_URL=http://localhost:3000
# Optional comma-separated CORS/origin allow-list. Defaults to APP_URL.
# ALLOWED_ORIGINS=http://localhost:3000

# --- Collab server (apps/collab) ---
COLLAB_PORT=4100

# --- Web (apps/web) ---
# Server-side URL the web app uses to reach the API.
API_INTERNAL_URL=http://localhost:4000

# --- Docker Compose (infra/docker-compose.yml) ---
POSTGRES_USER=conote
POSTGRES_PASSWORD=conote_dev_password
POSTGRES_DB=conote
