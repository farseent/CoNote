{
  "name": "@conote/collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoNote WebSocket/collaboration server foundation (Hocuspocus). No collaboration features until Phase 6.",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@conote/db": "workspace:*",
    "@conote/shared": "workspace:*",
    "@hocuspocus/server": "4.8.0",
    "ioredis": "5.6.1",
    "pino": "10.4.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0"
  }
}
