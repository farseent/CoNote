{
  "name": "@conote/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoNote REST API (Fastify).",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@conote/db": "workspace:*",
    "@conote/shared": "workspace:*",
    "fastify": "5.12.8",
    "ioredis": "5.6.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0"
  }
}
