# CoNote PRODUCTION configuration template for infra/docker-compose.prod.yml.
# Copy to `.env.production` ON THE SERVER, fill every value, keep the file readable only by the
# deploying user (chmod 600) and NEVER commit it. Everything below is a placeholder, not a secret.

# --- Public names (DNS A/AAAA records of both must point at the server before the first start) ---
APP_DOMAIN=app.example.com
COLLAB_DOMAIN=collab.example.com
# Contact address for the Let's Encrypt account (expiry notices).
ACME_EMAIL=ops@example.com

# --- Data services: generate each with `openssl rand -hex 24`; URL-safe by construction ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Collaboration token keys (D22): generate with `node scripts/generate-collab-keys.mjs`, then
# paste the two lines it prints exactly as printed (single-line JSON in single quotes; Docker
# Compose removes the quotes). The private key belongs to the API only, the public one to the
# collab server only. ---
COLLAB_JWT_PRIVATE_KEY=
COLLAB_JWT_PUBLIC_KEYS=

# --- Optional ---
LOG_LEVEL=info
